{
  "name": "Rumo aos 90 kg",
  "short_name": "Rumo 90",
  "description": "Acompanhamento do plano de emagrecimento e força: peso, treino, comida, pressão e exames.",
  "lang": "pt-BR",
  "start_url": "./#hoje",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0D2746",
  "theme_color": "#0D2746",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/*",
            "text/plain"
          ]
        }
      ]
    }
  }
}